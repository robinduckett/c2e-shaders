#include <metal_stdlib>
using namespace metal;

// CESHAD uniform block (buffer 0), byte-matching the host CeshadUniform.
struct CeshadUniform {
    float4 m0;        // (1/texW, 1/texH, texW, texH)
    float4 m1[32];    // tint tables (unused v1)
    float4 m2[32];
    float4 m3;        // m3.x = time (seconds)
    float4 m4;        // camera scale/offset
    float4 m5;        // world origin
    float4 m6[64];    // params: param(i) = m6[i/4][i%4]
};

struct FSIn {
    float4 colour   [[user(locn0)]];
    float2 uv       [[user(locn1)]];
    uint2  tint     [[user(locn2)]];
    float4 rect     [[user(locn3)]];
    float2 screenUV [[user(locn4)]];
    float2 centerUV [[user(locn5)]] [[flat]];
};

static inline float P(constant CeshadUniform& u, int i) { return u.m6[i / 4][i % 4]; }

fragment float4 main0(FSIn in [[stage_in]],
                      constant CeshadUniform& u [[buffer(0)]],
                      texture2d<float> sprite [[texture(0)]],
                      texture2d<float> scene  [[texture(1)]],
                      sampler samp [[sampler(0)]])
{
    float zoom       = (P(u, 0) > 0.0) ? P(u, 0) : 2.0;   // param0: magnification (>1 magnifies; sensible 2x default so an empty param vector doesn't collapse to a minified smear)
    float radius     = (P(u, 1) > 0.0) ? P(u, 1) : 0.42;  // param1: lens radius in uv (0..0.5)
    float refractAmt = P(u, 2);                           // param2: rim refraction (uv units)
    float dispersion = P(u, 3);                           // param3: chromatic dispersion

    float2 p = in.uv - 0.5;                               // centered lens space [-0.5, 0.5]
    float  d = length(p);

    float edge = 0.02;
    float mask = 1.0 - smoothstep(radius, radius + edge, d);
    float3 sceneHere = scene.sample(samp, in.screenUV).rgb;
    if (mask <= 0.0)
        return float4(sceneHere, 1.0);

    float2 dir = (d > 1e-4) ? p / d : float2(0.0);
    float  curve = smoothstep(0.0, radius, d);            // 0 centre -> 1 rim
    float2 base = in.centerUV + (in.screenUV - in.centerUV) / zoom;  // magnify about centre
    float2 refr = dir * refractAmt * curve;
    float2 disp = dir * dispersion * curve;

    float3 col;
    col.r = scene.sample(samp, base + refr + disp).r;
    col.g = scene.sample(samp, base + refr).g;
    col.b = scene.sample(samp, base + refr - disp).b;

    float rim = smoothstep(radius - 0.06, radius, d);     // fresnel-ish rim highlight
    col += rim * 0.25;

    float3 rgb = mix(sceneHere, col, mask);
    return float4(rgb, 1.0);
}
