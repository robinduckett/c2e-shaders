#include <metal_stdlib>
using namespace metal;

struct CeshadUniform {
    float4 m0; float4 m1[32]; float4 m2[32]; float4 m3; float4 m4; float4 m5; float4 m6[64];
};
struct FSIn {
    float4 colour   [[user(locn0)]];
    float2 uv       [[user(locn1)]];
    uint2  tint     [[user(locn2)]];
    float4 rect     [[user(locn3)]];
    float2 screenUV [[user(locn4)]];
    float2 centerUV [[user(locn5)]] [[flat]];
};
static inline float P(constant CeshadUniform& u, int i) { return u.m6[i / 4][i % 4]; }

// Full-view CRT post-process: barrel-distorts the scene the overlay covers,
// adds scanlines, a vignette, and RGB chromatic aberration. Reads texture(1)
// (the scene composited beneath it) at its own screen position (screenUV).
fragment float4 main0(FSIn in [[stage_in]],
                      constant CeshadUniform& u [[buffer(0)]],
                      texture2d<float> sprite [[texture(0)]],
                      texture2d<float> scene  [[texture(1)]],
                      sampler samp [[sampler(0)]])
{
    float curvature = (P(u,0) > 0.0) ? P(u,0) : 0.12;   // param0: barrel curvature
    float scan      = (P(u,1) > 0.0) ? P(u,1) : 0.30;   // param1: scanline strength
    float aberr     = (P(u,2) > 0.0) ? P(u,2) : 0.0016; // param2: chromatic aberration (uv)
    float lines     = (P(u,3) > 0.0) ? P(u,3) : 240.0;  // param3: scanline count

    // Barrel distortion about screen centre.
    float2 c = in.screenUV - 0.5;
    float r2 = dot(c, c);
    float2 warped = 0.5 + c * (1.0 + curvature * r2);

    // Outside the curved tube -> black bezel.
    if (warped.x < 0.0 || warped.x > 1.0 || warped.y < 0.0 || warped.y > 1.0)
        return float4(0.0, 0.0, 0.0, 1.0);

    // Chromatic aberration: split the RGB sample horizontally.
    float3 col;
    col.r = scene.sample(samp, warped + float2(aberr, 0.0)).r;
    col.g = scene.sample(samp, warped).g;
    col.b = scene.sample(samp, warped - float2(aberr, 0.0)).b;

    // Scanlines (fixed count across the tube).
    float sl = 0.5 + 0.5 * sin(warped.y * lines * 3.14159265);
    col *= (1.0 - scan) + scan * sl;

    // Vignette toward the corners.
    col *= smoothstep(0.75, 0.35, r2);

    return float4(col, 1.0);
}
