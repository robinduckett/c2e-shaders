#include <metal_stdlib>
using namespace metal;

struct CeshadUniform {
    float4 m0; float4 m1[32]; float4 m2[32]; float4 m3; float4 m4; float4 m5; float4 m6[64];
};
struct FSIn {
    float4 colour   [[user(locn0)]];
    float2 uv       [[user(locn1)]];
    uint2  tint     [[user(locn2)]];
    float4 rect     [[user(locn3)]];
    float2 screenUV [[user(locn4)]];
    float2 centerUV [[user(locn5)]] [[flat]];
};
static inline float P(constant CeshadUniform& u, int i) { return u.m6[i / 4][i % 4]; }

// Full-screen bloom post-process: bright-pass the composited scene, blur the bright
// pixels with a cheap cross of taps, and add the glow back over the original scene.
// Reads texture(1) (the scene composited beneath it) at screenUV over the whole frame.
fragment float4 main0(FSIn in [[stage_in]],
                      constant CeshadUniform& u [[buffer(0)]],
                      texture2d<float> sprite [[texture(0)]],
                      texture2d<float> scene  [[texture(1)]],
                      sampler samp [[sampler(0)]])
{
    float threshold = (P(u,0) > 0.0) ? P(u,0) : 0.7;   // param0: bright-pass luminance cutoff
    float intensity = (P(u,1) > 0.0) ? P(u,1) : 1.2;   // param1: additive glow strength
    float radius    = (P(u,2) > 0.0) ? P(u,2) : 2.0;   // param2: blur spread (in texel-ish steps)

    float2 uv = in.screenUV;
    float3 sceneColor = scene.sample(samp, uv).rgb;

    // No output-size uniform, so approximate a texel as a small fixed uv step.
    float2 step = float2(0.002, 0.002) * radius;

    // 9-tap cross/box of the bright-pass, weighted toward the centre.
    const int   N = 9;
    float2 offs[N] = {
        float2( 0.0,  0.0),
        float2( 1.0,  0.0), float2(-1.0,  0.0),
        float2( 0.0,  1.0), float2( 0.0, -1.0),
        float2( 1.0,  1.0), float2(-1.0,  1.0),
        float2( 1.0, -1.0), float2(-1.0, -1.0)
    };
    float weight[N] = { 4.0, 2.0, 2.0, 2.0, 2.0, 1.0, 1.0, 1.0, 1.0 };

    float3 bright = float3(0.0);
    float  wsum   = 0.0;
    for (int i = 0; i < N; ++i) {
        float3 s = scene.sample(samp, uv + offs[i] * step).rgb;
        float  l = dot(s, float3(0.2126, 0.7152, 0.0722));
        float3 b = s * max(l - threshold, 0.0) / max(1.0 - threshold, 1e-4);
        bright += b * weight[i];
        wsum   += weight[i];
    }
    bright /= wsum;

    float3 result = sceneColor + bright * intensity;
    return float4(result, 1.0);
}
